# Шаблон для nginx из docker-compose.standalone-nginx*.yml: ${SUBMW_DOMAIN} подставляется при старте контейнера.
# Сертификат читается по пути с переменной — nginx стартует до первого выпуска и подхватывает продлённый без перезагрузки.
map $ssl_server_name $submw_cert {
    default /etc/letsencrypt/live/${SUBMW_DOMAIN};
}

server {
    listen 80 default_server;
    server_name ${SUBMW_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SUBMW_DOMAIN};

    ssl_certificate     $submw_cert/fullchain.pem;
    ssl_certificate_key $submw_cert/privkey.pem;
    ssl_certificate_cache max=16 inactive=1h valid=10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 8m;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $submw_up http://submw:80;

    location / {
        proxy_pass $submw_up;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
